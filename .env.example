# EASY — variables du frontend Vite (exemple). Copier en .env.local pour le développement.
# ATTENTION : toutes les variables VITE_* sont PUBLIQUES (intégrées au bundle). Aucun secret ici.
# Sur Render (site statique) : les définir dans « Environment » AVANT le build.

VITE_API_URL=http://localhost:5000/api      # production : https://<backend>.onrender.com/api
VITE_WS_URL=http://localhost:5000           # production : https://<backend>.onrender.com
